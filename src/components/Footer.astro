---
import { ATTRACTION } from '../consts';
import { getDictionary, type LocaleCode } from '../i18n';

const props = Astro.props as {
  locale: LocaleCode | string;
};
const locale = (props.locale ?? 'fil') as LocaleCode;
const t = getDictionary(locale);
---

<footer class="bg-chocolate-900 text-chocolate-200 py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Top row: Logo + Info + Links -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-8">
      <!-- Logo & Description -->
      <div class="sm:col-span-1">
        <div class="flex items-center gap-2 mb-2">
          <img
            src="/favicon.svg"
            alt=""
            class="w-8 h-8 brightness-0 contrast-[2]"
            width="32"
            height="32"
            style="filter: invert(55%) sepia(30%) saturate(480%) hue-rotate(4deg) brightness(92%) contrast(90%);"
          />
          <span class="text-lg font-bold text-cream-300">{t._meta.siteTitleShort}</span>
        </div>
        <p class="text-sm text-chocolate-400 leading-relaxed">
          {ATTRACTION.name}<br />
          {ATTRACTION.addressStreet}, {ATTRACTION.addressCity}<br />
          {ATTRACTION.addressRegion}, {ATTRACTION.addressCountry}
        </p>
      </div>

      <!-- Quick Links -->
      <div class="sm:col-span-1">
        <h4 class="text-cream-300 font-semibold mb-2 text-sm uppercase tracking-wider">{t.footer.quickLinks}</h4>
        <ul class="space-y-1 text-sm">
          <li><a href="#about" class="hover:text-cream-300 transition-colors">{t.nav.about}</a></li>
          <li><a href="#gallery" class="hover:text-cream-300 transition-colors">{t.nav.gallery}</a></li>
          <li><a href="#fees" class="hover:text-cream-300 transition-colors">{t.nav.fees}</a></li>
          <li><a href="#transport" class="hover:text-cream-300 transition-colors">{t.nav.transport}</a></li>
          <li><a href="#faq" class="hover:text-cream-300 transition-colors">{t.nav.faq}</a></li>
        </ul>
      </div>

      <!-- Map Link -->
      <div class="sm:col-span-1">
        <h4 class="text-cream-300 font-semibold mb-2 text-sm uppercase tracking-wider">{t.footer.findUs}</h4>
        <a
          href={ATTRACTION.maps.share}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-chocolate-400 hover:text-cream-300 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {t.footer.viewOnMaps}
        </a>
      </div>
    </div>

    <!-- Bottom: Disclaimer + Copyright -->
    <div class="border-t border-chocolate-700 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-chocolate-500">
      <p>
        {t.footer.disclaimer}
      </p>
      <p>
        {t.footer.copyright.replace('{year}', String(new Date().getFullYear()))}
      </p>
    </div>
  </div>
</footer>
