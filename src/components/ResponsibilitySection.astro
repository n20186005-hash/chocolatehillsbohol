---
import { getDictionary, type LocaleCode } from '../i18n';

const props = Astro.props as { locale: LocaleCode | string };
const locale = (props.locale ?? 'en') as LocaleCode;
const t = getDictionary(locale);
---

<!-- 科普与访客责任 -->
<section id="responsibility" class="py-16 md:py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-8">
      <span class="text-leaf-600 font-semibold text-sm uppercase tracking-wider">{t.responsibility.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-chocolate-900 mt-2">
        {t.responsibility.heading}
      </h2>
      <p class="text-chocolate-600 mt-3 max-w-2xl mx-auto">{t.responsibility.intro}</p>
    </div>

    <div class="max-w-4xl mx-auto space-y-4">
      <div class="bg-cream-100 rounded-ch shadow-hill p-6">
        <h3 class="font-bold text-chocolate-800 text-lg">{t.responsibility.scienceTitle}</h3>
        <p class="text-sm text-chocolate-700 mt-2 leading-relaxed">{t.responsibility.scienceText}</p>
      </div>

      <div class="bg-cream-100 rounded-ch shadow-hill p-6">
        <h3 class="font-bold text-chocolate-800 text-lg">{t.responsibility.whyProtectedTitle}</h3>
        <p class="text-sm text-chocolate-700 mt-2 leading-relaxed">{t.responsibility.whyProtectedText}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="bg-leaf-50 rounded-ch shadow-hill p-6">
          <h3 class="font-bold text-leaf-700 text-lg">{t.responsibility.doTitle}</h3>
          <ul class="mt-3 space-y-2 text-sm text-chocolate-700">
            {
              t.responsibility.doItems.map((line) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-leaf-600 font-bold">✓</span>
                  <span class="leading-relaxed">{line}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-chocolate-100 rounded-ch shadow-hill p-6">
          <h3 class="font-bold text-chocolate-800 text-lg">{t.responsibility.avoidTitle}</h3>
          <ul class="mt-3 space-y-2 text-sm text-chocolate-700">
            {
              t.responsibility.avoidItems.map((line) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-chocolate-600 font-bold">✕</span>
                  <span class="leading-relaxed">{line}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p class="text-xs text-chocolate-500 leading-relaxed">{t.responsibility.closingNote}</p>
    </div>
  </div>
</section>
