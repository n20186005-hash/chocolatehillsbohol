---
import { getDictionary, type LocaleCode } from '../i18n';

const props = Astro.props as { locale: LocaleCode | string };
const locale = (props.locale ?? 'en') as LocaleCode;
const t = getDictionary(locale);
---

<!-- 按人群定制的游览方案 -->
<section id="audiences" class="py-16 md:py-20 bg-cream-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-8">
      <span class="text-leaf-600 font-semibold text-sm uppercase tracking-wider">{t.audiences.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-chocolate-900 mt-2">
        {t.audiences.heading}
      </h2>
      <p class="text-chocolate-600 mt-3 max-w-2xl mx-auto">{t.audiences.intro}</p>
    </div>

    <div class="grid lg:grid-cols-3 gap-4">
      {
        t.audiences.items.map((item) => (
          <article class="bg-white rounded-ch shadow-hill p-5">
            <h3 class="font-bold text-chocolate-800 text-lg">{item.title}</h3>
            <p class="text-xs text-chocolate-500 mt-1">{item.who}</p>
            <p class="text-sm font-semibold text-leaf-700 mt-2">{item.duration}</p>

            <ul class="mt-3 space-y-2 text-sm text-chocolate-700">
              {item.highlights.map((line) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-chocolate-500">•</span>
                  <span class="leading-relaxed">{line}</span>
                </li>
              ))}
            </ul>

            <div class="mt-4 pt-3 border-t border-cream-200">
              <ul class="space-y-2 text-xs text-chocolate-600">
                {item.tips.map((tip) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-leaf-600 font-bold">✓</span>
                    <span class="leading-relaxed">{tip}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
