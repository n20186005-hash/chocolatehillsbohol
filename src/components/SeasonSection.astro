---
import { getDictionary, type LocaleCode } from '../i18n';

const props = Astro.props as { locale: LocaleCode | string };
const locale = (props.locale ?? 'en') as LocaleCode;
const t = getDictionary(locale);
const c = t.season.columns;
---

<!-- 季度游览策略表：气象 / 景观 / 水体与野生动物 / 客流综合分析 -->
<section id="season" class="py-16 md:py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-8">
      <span class="text-leaf-600 font-semibold text-sm uppercase tracking-wider">{t.season.eyebrow}</span>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-chocolate-900 mt-2">
        {t.season.heading}
      </h2>
      <p class="text-chocolate-600 mt-3 max-w-2xl mx-auto">{t.season.intro}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-4 max-w-5xl mx-auto">
      {
        t.season.rows.map((row) => (
          <article class="bg-cream-100 rounded-ch shadow-hill p-5">
            <header class="flex items-baseline justify-between gap-3 border-b border-cream-200 pb-3">
              <h3 class="font-display font-bold text-2xl text-chocolate-900">{row.quarter}</h3>
              <span class="text-sm font-semibold text-chocolate-600">{row.months}</span>
            </header>
            <dl class="mt-3 space-y-3 text-sm">
              <div>
                <dt class="text-xs uppercase tracking-wider text-chocolate-500">{c.weather}</dt>
                <dd class="text-chocolate-700">{row.weather}</dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-wider text-chocolate-500">{c.hills}</dt>
                <dd class="text-chocolate-700">{row.hills}</dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-wider text-chocolate-500">{c.nature}</dt>
                <dd class="text-chocolate-700">{row.nature}</dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-wider text-chocolate-500">{c.crowd}</dt>
                <dd class="text-chocolate-700">{row.crowd}</dd>
              </div>
              <div class="pt-3 border-t border-cream-200">
                <dt class="text-xs uppercase tracking-wider text-leaf-600">{c.strategy}</dt>
                <dd class="text-chocolate-800 mt-1">{row.strategy}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>

    <p class="max-w-5xl mx-auto mt-6 text-xs text-chocolate-500 leading-relaxed">{t.season.caption}</p>
    <p class="max-w-5xl mx-auto mt-2 text-xs text-chocolate-600 leading-relaxed">{t.season.note}</p>
  </div>
</section>
