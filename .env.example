# ===== Burnham Park Baguio · Environment Variables (TEMPLATE) =====
# Kopyahin ang file na ito bilang `.env` at punuin ang mga halaga.
# Ang mga key na may prefix na PUBLIC_ ay makikita sa browser/client-side code.

# Ang buong URL ng site — ginagamit para sa canonical, OG, at sitemap
PUBLIC_SITE_URL=https://burnhamparkbaguio.com

# Ang pangalan ng site
PUBLIC_SITE_NAME=Burnham Park Baguio

# Google Analytics 4 Measurement ID (IPINAG-UUTOS NG USER)
PUBLIC_GA4_ID=G-HXM22WWPKP
